<!DOCTYPE html>
<html lang="en">
<%- include('head.ejs')%>
<body>
    <%- include('header.ejs')%>
    <main>
        <div class="wrapper" id="wrapper">
            <% products.forEach((product)=>{%>
                <div class="card">
                    <h3>
                        <%=product.title%>
                    </h3>
                    <p>
                        <%=product.description%>
                    </p>
          </div>
            <% }) %>
        </div>
        <%- include('modal.ejs')%>
        <input type="button" value="+" id="callFormButton">

    </main>
    <%- include('footer.ejs')%>
</body>
</html>