 <div class="modal">
    <div class="modalContent">
        <form id="addProductForm">
            <input type="button" value="X" class="closeButton" id="closeButton">
            <h2>Add Products</h2>

            <input type="text" name="title" id="titleInput" placeholder="Title" required>
            <textarea name="description" id="descriptionInput" placeholder="Description" required></textarea>
            <input type="submit" value="Add" class="addButton" id="addButton">
        </form>
    </div>
</div>